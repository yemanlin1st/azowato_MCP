{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/mcp", "destination": "/api/server" },
    { "source": "/mcp/:path*", "destination": "/api/server" }
  ],
  "functions": {
    "api/server.ts": { "maxDuration": 60 },
    "api/health.ts": { "maxDuration": 10 }
  }
}
